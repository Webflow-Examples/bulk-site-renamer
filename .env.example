# Copy to .env and fill in. Never commit .env.
# From your Webflow app: Workspace settings > Apps & Integrations > Develop
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
# Must match a redirect URI registered on the app
WEBFLOW_REDIRECT_URI=http://localhost:3000/callback
# Filled in by auth.py, do not paste by hand
WEBFLOW_ACCESS_TOKEN=
